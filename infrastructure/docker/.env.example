POSTGRES_PASSWORD=change_me_locally

# Ollama (local LLM for the log assistant)
OLLAMA_MODEL=llama3.2
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=15m

# Production stack (docker-compose.prod.yml)
IMAGE_REGISTRY=ghcr.io/hackee-fr
IMAGE_TAG=latest
# 127.0.0.1 keeps the dashboard local; use 0.0.0.0 to reach it from the network (no authentication yet).
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
# Set to "none" to run without the LLM.
LLM_PROVIDER=ollama
